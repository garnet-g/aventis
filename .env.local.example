# Copy to .env.local and fill in. `npx supabase status` prints the local values.

# Supabase (local stack: API on port 54421; use your hosted project's values in production)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, used in email links. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "dummy" (test mode, no money moves) is the only provider so far.
PAYMENT_PROVIDER=dummy

# Picture safety check (OpenAI moderation). Without it, development passes every picture and production sends
# every picture to manual review.
OPENAI_API_KEY=

# Email through Resend. Without a key, emails are only printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=VybeCrew <orders@your-domain.example>
# Optional: comma-separated addresses for new-order alerts. Defaults to every admin's own email.
ADMIN_ALERT_EMAILS=
