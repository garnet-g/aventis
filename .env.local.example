# Copy to .env.local and fill in. `npx supabase status` prints the local values.
# Never commit real keys. In production set these on the server (or in the Docker run command), not in a file in git.

# --- Supabase (local stack: API on port 54421; use your hosted project's values in production) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The site's public address, used in email and SMS links and for M-Pesa callbacks (must be https in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments ---
# "dummy": test mode, every payment succeeds at once and no money moves. "mpesa": Safaricom Daraja STK push.
PAYMENT_PROVIDER=dummy
# M-Pesa (Daraja). Get these from https://developer.safaricom.co.ke (sandbox) and, after Go Live, from Safaricom.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# The shortcode that receives the money (paybill number, or for a till: the store number Safaricom gives you).
MPESA_SHORTCODE=
MPESA_PASSKEY=
# "paybill" (CustomerPayBillOnline) or "till" (CustomerBuyGoodsOnline). For a till also set the till number.
MPESA_TRANSACTION_TYPE=paybill
MPESA_TILL_NUMBER=
# What the customer sees as the account on the M-Pesa prompt (max 12 characters).
MPESA_ACCOUNT_REFERENCE=VibeCrew
# A long random string; the callback address is /api/payments/mpesa/<this secret>. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=

# --- SMS through Celcom Africa (order paid / shipped / delivered / cancelled). Without these, SMS are only logged. ---
CELCOM_API_KEY=
CELCOM_PARTNER_ID=
# The approved sender name (shortcode) on your Celcom account.
CELCOM_SHORTCODE=
# Optional: only if Celcom gives you a different endpoint.
CELCOM_SMS_URL=

# --- Email through Resend. Without a key, emails are only printed in the server log. ---
RESEND_API_KEY=
EMAIL_FROM=VibeCrew <orders@vibecrew.co.ke>
# Optional: comma-separated addresses for new-order and refund alerts. Defaults to every admin's own email.
ADMIN_ALERT_EMAILS=

# --- Picture safety check (OpenAI moderation, free). Without it, development passes every picture and production
# sends every picture to manual review. ---
OPENAI_API_KEY=

# --- Business details shown on the legal, help and contact pages and in the footer ---
NEXT_PUBLIC_BUSINESS_NAME=VibeCrew
# The registered name on your business registration (eCitizen / BRS), shown in the terms of sale.
NEXT_PUBLIC_BUSINESS_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
# Kenyan numbers, as you want them shown (for example 0712 345 678).
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_BUSINESS_LOCATION=Nairobi, Kenya
NEXT_PUBLIC_BUSINESS_HOURS=Monday to Saturday, 9am to 6pm

# --- Housekeeping ---
# A long random string; the daily cleanup is POST /api/cron/cleanup with "Authorization: Bearer <this>".
CRON_SECRET=
# "off" turns every rate limit off (local testing only; never in production).
RATE_LIMITS=
